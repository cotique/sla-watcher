<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>sla-watcher</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.11" />
    <PackageReference Include="MongoDB.Driver" Version="3.11.0" />
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.19.1" />
    <PackageReference Include="cotique.Quartz.Spi.MongoDbJobStore" Version="2.2.0" />
    <PackageReference Include="Quartz.Serialization.SystemTextJson" Version="3.19.1" />
  </ItemGroup>

</Project>
